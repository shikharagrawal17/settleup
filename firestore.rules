rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────
    // Any signed-in user can read profiles (for phone lookup / member display).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared groups ─────────────────────────────────────────────────────
    // A group is readable/writable by any user listed in memberIds.
    match /groups/{groupId} {
      // Helper: is the caller a member of this group?
      function isMember() {
        return request.auth != null &&
               request.auth.uid in resource.data.memberIds;
      }

      // Helper for writes where resource may not yet exist (create).
      function willBeMember() {
        return request.auth != null &&
               request.auth.uid in request.resource.data.memberIds;
      }

      allow read: if isMember();

      // Create: caller must include themselves in memberIds.
      allow create: if willBeMember();

      // Update/delete: caller must currently be a member.
      allow update, delete: if isMember();

      // ── Expenses sub-collection ────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // ── Settlements sub-collection ─────────────────────────────────────
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }
  }
}
