rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- HELPER FUNCTIONS --
    
    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if their UID, Phone, or Email exists in the group's memberIdentifiers array
    function isMember(groupData) {
      return isSignedIn() && (
        request.auth.uid in groupData.memberIdentifiers ||
        (request.auth.token.phone_number != null && request.auth.token.phone_number in groupData.memberIdentifiers) ||
        (request.auth.token.email != null && request.auth.token.email in groupData.memberIdentifiers) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber in groupData.memberIdentifiers) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email in groupData.memberIdentifiers)
      );
    }

    function getGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // -- COLLECTION RULES --

    match /groups/{groupId} {
      allow read, update: if isMember(resource.data);
      allow create: if isSignedIn();
      allow delete: if isMember(resource.data);

      match /expenses/{expenseId} {
        allow read, write: if isMember(getGroup(groupId));
      }

      match /settlements/{settlementId} {
        allow read, write: if isMember(getGroup(groupId));
      }

      match /activities/{activityId} {
        allow read, write: if isMember(getGroup(groupId));
      }
    }

    // The app uses 'publicUsers' for profile storage
    match /publicUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Registry for looking up UIDs by email or phone
    match /registries/{registryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
