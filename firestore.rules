rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /publicUsers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'upiId', 'updatedAt']);
    }

    match /registries/{key} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Shared groups ─────────────────────────────────────────────────────
      function getPhoneId() {
        let phone = request.auth.token.phone_number;
        return phone.size() > 1 && phone.matches('^\\+.*') ? phone.split('\\+')[1] : phone;
      }

      function isMember() {
        return request.auth != null && (
          request.auth.uid in resource.data.memberIds ||
          (resource.data.keys().contains('memberLogins') && request.auth.uid in resource.data.memberLogins) ||
          request.auth.uid in resource.data.memberIdentifiers ||
          (request.auth.token.keys().contains('email') && request.auth.token.email.lower() in resource.data.memberIdentifiers) ||
          (request.auth.token.keys().contains('phone_number') && (request.auth.token.phone_number in resource.data.memberIdentifiers || getPhoneId() in resource.data.memberIdentifiers))
        );
      }

      function willBeMember() {
        return request.auth != null && (
          request.auth.uid in request.resource.data.memberIds ||
          (request.resource.data.keys().contains('memberLogins') && request.auth.uid in request.resource.data.memberLogins) ||
          request.auth.uid in request.resource.data.memberIdentifiers ||
          (request.auth.token.keys().contains('email') && request.auth.token.email.lower() in request.resource.data.memberIdentifiers) ||
          (request.auth.token.keys().contains('phone_number') && (request.auth.token.phone_number in request.resource.data.memberIdentifiers || getPhoneId() in request.resource.data.memberIdentifiers))
        );
      }

      allow read: if isMember();
      allow create: if willBeMember() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember();
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        function isGroupMember() {
          let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
          return request.auth != null && (
            request.auth.uid in groupData.memberIds ||
            (groupData.keys().contains('memberLogins') && request.auth.uid in groupData.memberLogins) ||
            request.auth.uid in groupData.memberIdentifiers ||
            (request.auth.token.keys().contains('email') && request.auth.token.email.lower() in groupData.memberIdentifiers) ||
            (request.auth.token.keys().contains('phone_number') && (request.auth.token.phone_number in groupData.memberIdentifiers || getPhoneId() in groupData.memberIdentifiers))
          );
        }
        allow read, create: if isGroupMember();
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      }

      match /settlements/{settlementId} {
        function isGroupMember() {
           let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
           return request.auth != null && (
            request.auth.uid in groupData.memberIds ||
            (groupData.keys().contains('memberLogins') && request.auth.uid in groupData.memberLogins) ||
            request.auth.uid in groupData.memberIdentifiers ||
            (request.auth.token.keys().contains('email') && request.auth.token.email.lower() in groupData.memberIdentifiers) ||
            (request.auth.token.keys().contains('phone_number') && (request.auth.token.phone_number in groupData.memberIdentifiers || getPhoneId() in groupData.memberIdentifiers))
          );
        }
        allow read, create: if isGroupMember();
        allow update: if isGroupMember();
        allow delete: if isGroupMember() && request.auth.uid == resource.data.createdBy;
      }

      match /activities/{activityId} {
        function isGroupMember() {
           let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
           return request.auth != null && (
            request.auth.uid in groupData.memberIds ||
            (groupData.keys().contains('memberLogins') && request.auth.uid in groupData.memberLogins) ||
            request.auth.uid in groupData.memberIdentifiers ||
            (request.auth.token.keys().contains('email') && request.auth.token.email.lower() in groupData.memberIdentifiers) ||
            (request.auth.token.keys().contains('phone_number') && (request.auth.token.phone_number in groupData.memberIdentifiers || getPhoneId() in groupData.memberIdentifiers))
          );
        }
        allow read, create: if isGroupMember();
        allow update, delete: if false; // Audit logs should be immutable
      }
    }
  }
}
