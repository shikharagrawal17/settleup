rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────
    // Any signed-in user can read profiles (for phone lookup / member display).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared groups ─────────────────────────────────────────────────────
    // A group is readable/writable by any user listed in memberIds or memberIdentifiers.
    match /groups/{groupId} {
      // Helper: is the caller a member of this group?
      function isMember() {
        return request.auth != null && (
               request.auth.uid in resource.data.memberIds ||
               request.auth.uid in resource.data.memberIdentifiers
        );
      }

      // Helper for writes where resource may not yet exist (create).
      function willBeMember() {
        return request.auth != null && (
               request.auth.uid in request.resource.data.memberIds ||
               request.auth.uid in request.resource.data.memberIdentifiers
        );
      }

      allow read: if isMember();

      // Create: caller must include themselves in memberIds or identifiers.
      allow create: if willBeMember();

      // Update: caller must be a member. 
      // All members can now rename, add/remove others, and transfer ownership.
      allow update: if isMember() && (
        request.auth.uid == resource.data.createdBy || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['netBalances', 'updatedAt', 'members', 'memberIds', 'memberIdentifiers', 'name', 'createdBy'])
      );

      // Delete: strictly owner only.
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      // ── Expenses sub-collection ────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIdentifiers
        );
        allow create: if request.auth != null && request.resource.data.amount > 0;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      }

      // ── Settlements sub-collection ─────────────────────────────────────
      match /settlements/{settlementId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIdentifiers
        );
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      }
    }
  }
}
