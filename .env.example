# ==============================================================================
# Bharat Dues / Open Source Agent Environment Configuration
# Copy this file to .env before starting the container or running locally:
#   cp .env.example .env
# ==============================================================================

# Port configuration for Docker container / Web Server
PORT=8080
HOST=0.0.0.0

# Google Gemini / Gemma AI Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Project Configuration (Optional for local demo mode)
FIREBASE_PROJECT_ID=bharat-dues-dev
FIREBASE_API_KEY=AIzaSyDummyKeyForLocalDev
FIREBASE_AUTH_DOMAIN=bharat-dues-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=bharat-dues-dev.appspot.com

# Feature Flags
ENABLE_AI_RECEIPT_OCR=true
ENABLE_OFFLINE_HEURISTICS=true
ENABLE_DEV_LOGGING=false
